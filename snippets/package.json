{
  "name": "custom-snippets",
  "contributes": {
    "snippets": [
      {
        "language": [
          "cs"
        ],
        "path": "./cs.json"
      },
      {
        "language": [
          "sql"
        ],
        "path": "./sql.json"
      },
      {
        "path": "./http.json",
        "language": [
          "http"
        ]
      },
      {
        "language": [
          "md",
          "markdown"
        ],
        "path": "./markdown.json"
      }
    ]
  }
}
